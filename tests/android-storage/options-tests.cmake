cmake_minimum_required(VERSION 3.19)

function(check_options expected canonical legacy)
  unset(MATSDK_ANDROID_USE_ROOM CACHE)
  unset(USE_ROOM CACHE)
  if(NOT canonical STREQUAL "unset")
    set(MATSDK_ANDROID_USE_ROOM "${canonical}" CACHE BOOL "")
  endif()
  if(NOT legacy STREQUAL "unset")
    set(USE_ROOM "${legacy}" CACHE BOOL "")
  endif()
  set(CMAKE_SYSTEM_NAME Android)
  include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/MatsdkOptions.cmake")
  if((expected AND NOT MATSDK_ANDROID_USE_ROOM)
      OR (NOT expected AND MATSDK_ANDROID_USE_ROOM))
    message(FATAL_ERROR "Unexpected Room selection: canonical=${canonical}, legacy=${legacy}")
  endif()
  if(expected AND NOT MATSDK_SQLITE_PROVIDER_RESOLVED STREQUAL "NONE")
    message(FATAL_ERROR "Room must not depend on SQLite by default.")
  elseif(NOT expected AND NOT MATSDK_SQLITE_PROVIDER_RESOLVED STREQUAL "VENDORED")
    message(FATAL_ERROR "SQLite storage must resolve its native dependency.")
  endif()
endfunction()

check_options(OFF unset unset)
check_options(ON ON unset)
check_options(OFF OFF unset)
check_options(ON unset ON)
check_options(OFF unset OFF)
check_options(ON ON OFF)
check_options(OFF OFF ON)
message(STATUS "Android storage option compatibility and precedence passed")
